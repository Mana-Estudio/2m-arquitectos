---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Flecha from '../../components/Flecha.astro';
import Cta from '../../components/Cta.astro';
import { proyectos, fotos, waTexto } from '../../data';
const unicos = (k: 'tipo' | 'zona', orden: string[]) => orden.filter((v) => proyectos.some((p) => p[k] === v));
const tipos = ['Todos', ...unicos('tipo', ['Viviendas', 'Edificios', 'Terciario', 'Reformas'])];
const zonas = ['Todas', ...unicos('zona', ['Madrid', 'Galicia', 'Málaga'])];
const previas = await Promise.all(proyectos.map((p) => getImage({ src: fotos(p.slug)[0], width: 560, format: 'webp', quality: 72 })));
---
<Base title="Proyectos de arquitectura en Madrid · 2M Arquitectos" activo="proyectos"
  description="Viviendas unifamiliares, promociones, edificios y terciario en Madrid, Galicia y Málaga. Conoce los proyectos de 2M Arquitectos.">
  <div class="wrap" style="padding-top:clamp(48px,6vw,96px);padding-bottom:var(--sec)">
    <div class="p-intro">
      <h1 class="h1">Proyectos <sup class="mono">{proyectos.length}</sup></h1>
      <p class="lead">“El movimiento se demuestra andando.” Viviendas unifamiliares, promociones, edificios y terciario en Madrid, Galicia y Málaga.</p>
    </div>
    <div class="barra-f">
      <div role="group" aria-label="Filtrar proyectos" class="filtros">
        <div><span>Tipología</span>{tipos.map((t, i) => <button type="button" data-f="tipo" data-v={t} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}</div>
        <div><span>Zona</span>{zonas.map((t, i) => <button type="button" data-f="zona" data-v={t} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}</div>
      </div>
      <div class="vistas" role="group" aria-label="Vista">
        <button type="button" data-vista="galeria" aria-pressed="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect width="7" height="7"/><rect x="9" width="7" height="7"/><rect y="9" width="7" height="7"/><rect x="9" y="9" width="7" height="7"/></svg>Galería</button>
        <button type="button" data-vista="lista" aria-pressed="false"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect width="16" height="2" y="2"/><rect width="16" height="2" y="7"/><rect width="16" height="2" y="12"/></svg>Lista</button>
      </div>
    </div>
    <p aria-live="polite" class="muted conteo" style="font-size:14px;margin-bottom:24px">{proyectos.length} proyectos</p>
    <h2 class="sr">Listado de proyectos</h2>

    <div class="grilla lista-p" data-modo="galeria">
      {proyectos.map((p, i) => <div class:list={['celda', { ancha: i % 7 === 0 }]} data-tipo={p.tipo} data-zona={p.zona}><Tarjeta p={p} sizes={i % 7 === 0 ? '(min-width: 960px) 66vw, 100vw' : '(min-width: 960px) 33vw, 100vw'} /></div>)}
      <aside class="celda lead-card" data-fijo>
        <span class="ojo ojo-c">¿Tienes parcela?</span>
        <p>Te decimos qué puedes construir en ella antes de empezar.</p>
        <a href={waTexto('Hola, 2M Arquitectos. Tengo una parcela y quiero saber qué puedo construir.')} class="btn btn-c magnet" rel="noopener">Consultar gratis</a>
      </aside>
    </div>

    <ol class="filas" hidden>
      {proyectos.map((p, i) => (
        <li data-tipo={p.tipo} data-zona={p.zona}>
          <a href={`/proyectos/${p.slug}/`} data-previa={previas[i].src}>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="f-n">{p.nombre}</span>
            <span class="f-l">{p.lugar}</span>
            <span class="f-t">{p.tipo}</span>
            <Flecha />
          </a>
        </li>
      ))}
    </ol>
    <img class="previa" alt="" aria-hidden="true" />

    <div class="vacio" hidden>
      <p style="font:400 24px/1.3 var(--titulo);max-width:32ch">Todavía no hemos publicado proyectos con estos filtros.</p>
      <p class="muted">Si tienes un proyecto de este tipo, cuéntanoslo.</p>
      <div class="fila"><button type="button" class="btn btn-l limpiar">Quitar filtros</button><a href="/presupuesto/" class="btn btn-v">Calcular presupuesto</a></div>
    </div>
  </div>
  <Cta titulo="¿Quieres un proyecto como estos?" foto="las-rozas" />
</Base>

<style>
.p-intro{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:20px 64px;align-items:end;margin-bottom:clamp(32px,4vw,56px)}
.p-intro sup{font-size:16px;vertical-align:super;color:var(--verde)}
.barra-f{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:16px;padding:20px 0;border-top:1px solid var(--texto);border-bottom:1px solid var(--linea);margin-bottom:24px;position:sticky;top:0;z-index:5;background:var(--fondo)}
.filtros{display:grid;gap:12px}
.filtros>div{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.filtros span{font-size:14px;color:var(--suave);width:84px}
.filtros button,.vistas button{min-height:44px;padding:0 18px;border:1px solid var(--linea);border-radius:22px;background:transparent;color:var(--texto);font:400 15px 'IBM Plex Sans',sans-serif;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:background-color .25s,color .25s,border-color .25s}
.filtros button:hover,.vistas button:hover{border-color:var(--texto)}
.filtros button[aria-pressed=true],.vistas button[aria-pressed=true]{background:var(--texto);border-color:var(--texto);color:#fff}
.vistas{display:flex;gap:6px}
@media (max-width:759px){.barra-f{position:static}.filtros span{width:100%}}
.lista-p{--min:340px}
.celda[hidden],.lista-p[hidden]{display:none}
@media (min-width:960px){.celda.ancha{grid-column:span 2}.celda.ancha :global(.foto){aspect-ratio:16/9}}
.lead-card{background:var(--verde);color:#fff;padding:clamp(24px,3vw,40px);display:grid;gap:20px;align-content:end;justify-items:start;min-height:320px}
.lead-card p{font:300 clamp(24px,2.2vw,32px)/1.15 var(--titulo);letter-spacing:-.02em}
.filas{list-style:none;margin:0;padding:0;border-top:1px solid var(--texto)}
.filas[hidden],.filas li[hidden]{display:none}
.filas a{display:grid;grid-template-columns:44px 2fr 1.4fr 1fr 24px;gap:16px;align-items:center;padding:22px 0;border-bottom:1px solid var(--linea);text-decoration:none;color:var(--texto);transition:padding .4s cubic-bezier(.16,1,.3,1),color .3s}
.f-n{font:400 clamp(20px,2vw,28px)/1.2 var(--titulo);letter-spacing:-.02em}
.f-l,.f-t{color:var(--suave);font-size:15px}
.filas a:hover{padding-left:16px;color:var(--verde)}
@media (max-width:759px){.filas a{grid-template-columns:32px 1fr 20px}.f-l,.f-t{display:none}}
.previa{position:fixed;left:0;top:0;width:280px;aspect-ratio:4/3;object-fit:cover;pointer-events:none;z-index:40;opacity:0;scale:.85;transition:opacity .3s,scale .4s cubic-bezier(.16,1,.3,1);box-shadow:0 30px 60px -20px rgba(0,0,0,.35)}
.previa.on{opacity:1;scale:1}
.vacio{border:1px solid var(--linea);padding:clamp(32px,5vw,64px);display:grid;gap:16px;justify-items:start}
.vacio[hidden]{display:none}
</style>
<script>
  const estado: Record<string, string> = { tipo: 'Todos', zona: 'Todas' };
  const celdas = [...document.querySelectorAll<HTMLElement>('.lista-p .celda:not([data-fijo])')];
  const filas = [...document.querySelectorAll<HTMLElement>('.filas li')];
  const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-f]')];
  const aplicar = () => {
    let n = 0;
    celdas.forEach((t, i) => {
      const ok = (estado.tipo === 'Todos' || t.dataset.tipo === estado.tipo) && (estado.zona === 'Todas' || t.dataset.zona === estado.zona);
      t.hidden = !ok; filas[i].hidden = !ok; if (ok) n++;
    });
    botones.forEach((b) => b.setAttribute('aria-pressed', String(estado[b.dataset.f!] === b.dataset.v)));
    document.querySelector('.conteo')!.textContent = `${n} ${n === 1 ? 'proyecto' : 'proyectos'}`;
    (document.querySelector('.vacio') as HTMLElement).hidden = n > 0;
  };
  const transicion = (fn: () => void) => {
    const d = document as Document & { startViewTransition?: (f: () => void) => unknown };
    if (d.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.startViewTransition(fn); else fn();
  };
  botones.forEach((b) => b.addEventListener('click', () => transicion(() => { estado[b.dataset.f!] = b.dataset.v!; aplicar(); })));
  document.querySelector('.limpiar')!.addEventListener('click', () => transicion(() => { estado.tipo = 'Todos'; estado.zona = 'Todas'; aplicar(); }));

  // Cambio de vista, recordado por visitante
  const grid = document.querySelector<HTMLElement>('.lista-p')!, lista = document.querySelector<HTMLElement>('.filas')!;
  const vistaBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-vista]')];
  const vista = (v: string) => {
    grid.hidden = v !== 'galeria'; lista.hidden = v !== 'lista';
    vistaBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vista === v)));
    try { localStorage.setItem('2m-vista', v); } catch {}
  };
  vistaBtns.forEach((b) => b.addEventListener('click', () => transicion(() => vista(b.dataset.vista!))));
  try { const g = localStorage.getItem('2m-vista'); if (g) vista(g); } catch {}

  // Vista previa que sigue al cursor en la lista
  const previa = document.querySelector<HTMLImageElement>('.previa')!;
  if (matchMedia('(pointer:fine)').matches) {
    let x = 0, y = 0, px = 0, py = 0, activo = false;
    const bucle = () => { px += (x - px) * .15; py += (y - py) * .15; previa.style.transform = `translate(${px + 24}px, ${py - 100}px)`; if (activo) requestAnimationFrame(bucle); };
    lista.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
      a.addEventListener('pointerenter', () => { previa.src = a.dataset.previa!; previa.classList.add('on'); if (!activo) { activo = true; px = x; py = y; bucle(); } });
      a.addEventListener('pointerleave', () => { previa.classList.remove('on'); activo = false; });
    });
    addEventListener('pointermove', (e) => { x = e.clientX; y = e.clientY; }, { passive: true });
  }
</script>
