---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Cta from '../../components/Cta.astro';
import Flecha from '../../components/Flecha.astro';
import { proyectos, fotos, WA, type Proyecto } from '../../data';

export function getStaticPaths() {
  return proyectos.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Proyecto };
const imgs = fotos(p.slug);
const corto = `${p.nombre} en ${p.lugar.split(',')[0]}`;
const galeria = imgs.slice(1).length ? imgs.slice(1) : imgs;
const grandes = await Promise.all(galeria.map((i) => getImage({ src: i, width: Math.min(2000, i.width), format: 'webp', quality: 80 })));
const idx = proyectos.findIndex((x) => x.slug === p.slug);
const siguiente = proyectos[(idx + 1) % proyectos.length];
// Galería: una ancha y dos medias; si la última media queda sola, pasa a ancha para no dejar hueco
const esAncha = (i: number) => i % 3 === 0 || (i === galeria.length - 1 && i % 3 === 1);
const relacionados = [...proyectos.filter((x) => x.tipo === p.tipo), ...proyectos.filter((x) => x.tipo !== p.tipo)].filter((x) => x.slug !== p.slug && x.slug !== siguiente.slug).slice(0, 3);
---
<Base title={`${p.nombre} en ${p.lugar} · 2M Arquitectos`} activo="proyectos"
  description={`${p.descripcion[0]} Proyecto de 2M Arquitectos, estudio de arquitectura en Boadilla del Monte.`}>
  <section class="d-hero caja">
    <Foto src={imgs[0]} alt={`${corto}: imagen principal del proyecto`} sizes="(min-width: 1360px) 1280px, 100vw" prioridad class="d-foto" style={`view-transition-name:foto-${p.slug}`} />
    <div class="d-velo" aria-hidden="true"></div>
    <div class="d-txt">
      <nav aria-label="Ruta" class="d-ruta"><a href="/proyectos/">Proyectos</a><span aria-hidden="true">/</span><span>{p.tipo}</span></nav>
      <h1>{p.nombre}</h1>
      <p>{p.lugar}</p>
    </div>
  </section>

  <div class="wrap ficha">
    <section aria-labelledby="h-desc" style="display:grid;gap:20px;max-width:62ch">
      <h2 id="h-desc" class="h2s">El proyecto</h2>
      {p.descripcion.map((d) => <p style="font-size:18px;line-height:1.7;color:#2A2C29">{d}</p>)}
      <p style="font-size:18px;line-height:1.7;color:#2A2C29">En 2M Arquitectos nos encargamos del proyecto básico y de ejecución y de la dirección de obra, con arquitecto y aparejador.</p>
    </section>
    <aside aria-labelledby="h-ficha" class="ficha-lat">
      <div>
        <h2 id="h-ficha" style="font:500 14px 'IBM Plex Sans',sans-serif;color:var(--suave);padding-bottom:14px;border-bottom:1px solid var(--texto)">Ficha técnica</h2>
        <dl>
          <div><dt>Ubicación</dt><dd>{p.lugar}</dd></div>
          <div><dt>Tipología</dt><dd>{p.tipologia}</dd></div>
          <div><dt>Categoría</dt><dd>{p.tipo}</dd></div>
          <div><dt>Servicios</dt><dd>Proyecto y dirección de obra</dd></div>
          <div><dt>Imágenes</dt><dd>{imgs.length}</dd></div>
        </dl>
      </div>
      <form class="similar" data-wa={WA} data-proy={`${p.nombre} (${p.lugar})`}>
        <p style="font:400 22px/1.25 var(--titulo)">¿Quieres un proyecto como este?</p>
        <p class="muted" style="font-size:14px">Déjanos tu nombre y te escribimos por WhatsApp.</p>
        <label class="sr" for="s-n">Nombre</label><input id="s-n" name="nombre" placeholder="Tu nombre" required autocomplete="name" />
        <button class="btn btn-v btn-f" type="submit">Lo quiero similar <Flecha /></button>
        <a href={`/presupuesto/?tipo=${p.tipo === 'Reformas' ? 'reforma' : 'vivienda'}`} class="link" style="font-size:15px">o calcula tu presupuesto <Flecha /></a>
      </form>
    </aside>
  </div>

  <section class="wrap" aria-labelledby="h-gal" style="padding-bottom:var(--sec)">
    <div class="cab-sec" style="margin-bottom:24px"><h2 id="h-gal" class="h2s">Galería</h2><span class="muted" style="font-size:14px">Pulsa una imagen para verla a pantalla completa</span></div>
    <div class="galeria">
      {galeria.map((img, i) => (
        <button type="button" class:list={['g-item', { ancho: esAncha(i) }]} data-i={i} aria-label={`Ampliar imagen ${i + 1} de ${galeria.length}`}>
          <Foto src={img} alt={`${corto}: imagen ${i + 1} de ${galeria.length}`} sizes={esAncha(i) ? '(min-width: 1360px) 1280px, 100vw' : '(min-width: 1360px) 640px, (min-width: 960px) 50vw, 100vw'} />
        </button>
      ))}
    </div>
  </section>

  <a href={`/proyectos/${siguiente.slug}/`} class="sig-p caja">
    <Foto src={fotos(siguiente.slug)[0]} alt="" sizes="(min-width: 1360px) 1280px, 100vw" class="sig-foto" />
    <span class="sig-txt"><span class="ojo ojo-c">Siguiente proyecto</span><b>{siguiente.nombre}</b><span>{siguiente.lugar} <Flecha /></span></span>
  </a>

  <section class="wrap" aria-labelledby="h-rel" style="padding-block:var(--sec)">
    <div class="cab-sec"><h2 id="h-rel" class="h2s">Proyectos relacionados</h2><a href="/proyectos/" class="link">Ver todos <Flecha /></a></div>
    <div class="grilla" style="--min:340px">{relacionados.map((r) => <Tarjeta p={r} />)}</div>
  </section>

  <Cta titulo="Cuéntanos tu proyecto" />

  <dialog class="lb" aria-label="Galería a pantalla completa" data-src={JSON.stringify(grandes.map((g) => g.src))} data-alt={corto}>
    <div class="lb-top"><span class="lb-n mono"></span><button type="button" class="lb-x">Cerrar <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.25"/></svg></button></div>
    <img class="lb-img" alt="" />
    <div class="lb-pie"><button type="button" class="lb-ant" aria-label="Imagen anterior"><Flecha dir="izq" /></button><button type="button" class="lb-sig" aria-label="Imagen siguiente"><Flecha /></button></div>
  </dialog>
</Base>

<style>
.d-hero{position:relative;height:min(calc(100svh - 72px - clamp(12px,1.5vw,24px)),820px);min-height:480px;margin-top:clamp(8px,1vw,16px);overflow:hidden;color:#fff;background:#363935}
.d-hero :global(.d-foto){position:absolute;inset:0}
@supports (animation-timeline:scroll()){.d-hero :global(.d-foto img){animation:par linear both;animation-timeline:scroll(root);animation-range:0 100vh}@keyframes par{to{transform:translateY(14%) scale(1.06)}}}
.d-velo{position:absolute;inset:0;background:linear-gradient(to top,rgba(20,22,20,.78),rgba(20,22,20,0) 55%)}
.d-txt{position:absolute;left:0;right:0;bottom:0;padding:0 var(--in) clamp(24px,3.5vw,48px);display:grid;gap:12px;animation:sube 1s .2s cubic-bezier(.16,1,.3,1) both}
@keyframes sube{from{opacity:0;transform:translateY(20px)}}
.d-ruta{display:flex;gap:8px;font-size:14px;color:#D8D5CE}.d-ruta a{color:#fff}
.d-txt h1{font:300 clamp(40px,6vw,96px)/1 var(--titulo);letter-spacing:-.04em;max-width:16ch;text-wrap:balance}
.d-txt p{font-size:18px;color:#E4E1DA}
.similar{background:var(--piedra);padding:24px;display:grid;gap:12px}
.similar input{height:52px;padding:0 14px;border:1px solid #8C877E;background:#fff;font:400 16px 'IBM Plex Sans',sans-serif;border-radius:0}
.similar input:focus{outline:none;border-color:var(--verde);box-shadow:0 0 0 3px rgba(62,107,79,.18)}
.sig-p{position:relative;display:block;height:clamp(280px,34vw,480px);overflow:hidden;color:#fff;text-decoration:none;background:#363935}
.sig-p :global(.sig-foto){position:absolute;inset:0}
.sig-p :global(.sig-foto img){transition:transform 1.2s cubic-bezier(.16,1,.3,1)}
.sig-p:hover :global(.sig-foto img){transform:scale(1.05)}
.sig-p::after{content:'';position:absolute;inset:0;background:rgba(20,22,20,.5);transition:background-color .5s}
.sig-p:hover::after{background:rgba(20,22,20,.3)}
.sig-txt{position:absolute;inset:auto 0 0;z-index:1;display:grid;gap:12px;padding:0 var(--in) clamp(24px,3.5vw,48px)}
.sig-txt b{font:300 clamp(36px,5vw,80px)/1 var(--titulo);letter-spacing:-.04em}
.sig-txt>span:last-child{display:flex;gap:10px;align-items:center;color:#E4E1DA}
@media (prefers-reduced-motion:reduce){.d-txt,.d-hero :global(.d-foto img){animation:none}}
.ficha{padding-block:var(--sec);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:36px clamp(32px,5vw,88px);align-items:start}
.ficha-lat{display:grid;gap:28px;position:sticky;top:104px}
dl>div{display:grid;grid-template-columns:130px 1fr;gap:16px;padding:16px 0;border-bottom:1px solid var(--linea)}
dt{font-size:15px;color:var(--suave)}dd{font-size:16px}
.galeria{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:clamp(12px,1.6vw,24px)}
.g-item{padding:0;border:0;background:none;cursor:zoom-in;aspect-ratio:4/3;width:100%}
.g-item.ancho{grid-column:1/-1;aspect-ratio:16/9}
.g-item :global(.foto){height:100%}
.lb{border:0;padding:0;width:100vw;height:100dvh;max-width:none;max-height:none;background:#141614;color:#F7F5F1}
.lb[open]{display:grid;grid-template-rows:auto 1fr auto;animation:lb-in .35s cubic-bezier(.16,1,.3,1)}
@keyframes lb-in{from{opacity:0}}
.lb-img{transition:opacity .25s ease}.lb-img.cambia{opacity:0}
@media (prefers-reduced-motion:reduce){.lb[open]{animation:none}.lb-img{transition:none}}
.lb-top,.lb-pie{display:flex;justify-content:space-between;align-items:center;padding:12px clamp(12px,3vw,32px)}
.lb-n{color:#C9C5BD}
.lb button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-width:52px;height:48px;padding:0 16px;border:1px solid #5A5D58;background:transparent;color:#F7F5F1;font:400 16px 'IBM Plex Sans',sans-serif;cursor:pointer}
.lb-img{width:100%;height:100%;object-fit:contain;min-height:0}
</style>
<script>
  const lb = document.querySelector<HTMLDialogElement>('.lb')!;
  const srcs: string[] = JSON.parse(lb.dataset.src!);
  const img = lb.querySelector<HTMLImageElement>('.lb-img')!;
  let i = 0;
  const ver = (n: number) => {
    i = (n + srcs.length) % srcs.length;
    img.classList.add('cambia');
    const nueva = new Image(); nueva.src = srcs[i];
    nueva.decode().catch(() => {}).finally(() => { img.src = srcs[i]; img.classList.remove('cambia'); });
    img.alt = `${lb.dataset.alt}: imagen ${i + 1} de ${srcs.length}`;
    lb.querySelector('.lb-n')!.textContent = `${i + 1} / ${srcs.length}`;
  };
  document.querySelectorAll<HTMLButtonElement>('.g-item').forEach((b) => b.addEventListener('click', () => { ver(+b.dataset.i!); lb.showModal(); }));
  lb.querySelector('.lb-x')!.addEventListener('click', () => lb.close());
  lb.querySelector('.lb-ant')!.addEventListener('click', () => ver(i - 1));
  lb.querySelector('.lb-sig')!.addEventListener('click', () => ver(i + 1));
  // Deslizar en móvil
  let tx = 0;
  lb.addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 50) ver(i + (dx < 0 ? 1 : -1)); });
  // Formulario "lo quiero similar"
  const sim = document.querySelector<HTMLFormElement>('.similar')!;
  sim.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre = (sim.elements.namedItem('nombre') as HTMLInputElement).value.trim();
    window.open(`${sim.dataset.wa}?text=${encodeURIComponent(`Hola, soy ${nombre}. He visto el proyecto ${sim.dataset.proy} en vuestra web y me gustaría algo similar.`)}`, '_blank', 'noopener');
  });
  lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') ver(i + 1); if (e.key === 'ArrowLeft') ver(i - 1); });
</script>
