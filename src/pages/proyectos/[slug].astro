---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Cta from '../../components/Cta.astro';
import Flecha from '../../components/Flecha.astro';
import { proyectos, fotos, WA, TEL, type Proyecto } from '../../data';

export function getStaticPaths() {
  return proyectos.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Proyecto };
const imgs = fotos(p.slug);
const corto = `${p.nombre} en ${p.lugar.split(',')[0]}`;
const galeria = imgs.slice(1).length ? imgs.slice(1) : imgs;
const grandes = await Promise.all(galeria.map((i) => getImage({ src: i, width: Math.min(2000, i.width), format: 'webp', quality: 80 })));
const relacionados = proyectos.filter((x) => x.slug !== p.slug).slice(0, 3);
---
<Base title={`${p.nombre} en ${p.lugar} · 2M Arquitectos`} activo="proyectos"
  description={`${p.descripcion[0]} Proyecto de 2M Arquitectos, estudio de arquitectura en Boadilla del Monte.`}>
  <Foto src={imgs[0]} alt={`${corto}: imagen principal del proyecto`} sizes="100vw" prioridad style="height:clamp(420px,56vw,820px);max-height:calc(100svh - 72px)" />

  <div class="wrap" style="padding-top:clamp(40px,5vw,72px)">
    <nav aria-label="Ruta" class="muted" style="font-size:14px;display:flex;gap:8px;margin-bottom:20px"><a href="/proyectos/" class="muted">Proyectos</a><span aria-hidden="true">/</span><span>{p.tipo}</span></nav>
    <h1 style="font:300 clamp(38px,5.4vw,80px)/1.02 var(--titulo);letter-spacing:-.035em;max-width:18ch;text-wrap:balance">{p.nombre}</h1>
    <p class="muted" style="font-size:18px;margin-top:14px">{p.lugar}</p>
  </div>

  <div class="wrap ficha">
    <section aria-labelledby="h-desc" style="display:grid;gap:20px;max-width:62ch">
      <h2 id="h-desc" class="h2s">El proyecto</h2>
      {p.descripcion.map((d) => <p style="font-size:18px;line-height:1.7;color:#2A2C29">{d}</p>)}
      <p style="font-size:18px;line-height:1.7;color:#2A2C29">En 2M Arquitectos nos encargamos del proyecto básico y de ejecución y de la dirección de obra, con arquitecto y aparejador.</p>
    </section>
    <aside aria-labelledby="h-ficha" class="ficha-lat">
      <div>
        <h2 id="h-ficha" style="font:500 14px 'IBM Plex Sans',sans-serif;color:var(--suave);padding-bottom:14px;border-bottom:1px solid var(--texto)">Ficha técnica</h2>
        <dl>
          <div><dt>Ubicación</dt><dd>{p.lugar}</dd></div>
          <div><dt>Tipología</dt><dd>{p.tipologia}</dd></div>
        </dl>
      </div>
      <div style="background:var(--piedra);padding:24px;display:grid;gap:14px">
        <p style="font:400 22px/1.25 var(--titulo)">¿Quieres un proyecto como este?</p>
        <a href="/contacto/" class="btn btn-v">Pedir presupuesto</a>
        <a href={WA} class="btn btn-l" rel="noopener">WhatsApp · {TEL}</a>
      </div>
    </aside>
  </div>

  <section class="wrap" aria-labelledby="h-gal" style="padding-bottom:clamp(72px,8vw,120px)">
    <div class="cab-sec" style="margin-bottom:24px"><h2 id="h-gal" class="h2s">Galería</h2><span class="muted" style="font-size:14px">Pulsa una imagen para verla a pantalla completa</span></div>
    <div class="galeria">
      {galeria.map((img, i) => (
        <button type="button" class:list={['g-item', { ancho: i % 3 === 0 }]} data-i={i} aria-label={`Ampliar imagen ${i + 1} de ${galeria.length}`}>
          <Foto src={img} alt={`${corto}: imagen ${i + 1} de ${galeria.length}`} sizes={i % 3 === 0 ? '100vw' : '(min-width: 960px) 50vw, 100vw'} />
        </button>
      ))}
    </div>
  </section>

  <section class="wrap" aria-labelledby="h-rel" style="padding-bottom:clamp(72px,8vw,120px)">
    <div class="cab-sec"><h2 id="h-rel" class="h2s">Proyectos relacionados</h2><a href="/proyectos/" class="link">Ver todos <Flecha /></a></div>
    <div class="grilla" style="--min:340px">{relacionados.map((r) => <Tarjeta p={r} />)}</div>
  </section>

  <Cta titulo="Cuéntanos tu proyecto" />

  <dialog class="lb" aria-label="Galería a pantalla completa" data-src={JSON.stringify(grandes.map((g) => g.src))} data-alt={corto}>
    <div class="lb-top"><span class="lb-n mono"></span><button type="button" class="lb-x">Cerrar <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.25"/></svg></button></div>
    <img class="lb-img" alt="" />
    <div class="lb-pie"><button type="button" class="lb-ant" aria-label="Imagen anterior"><Flecha dir="izq" /></button><button type="button" class="lb-sig" aria-label="Imagen siguiente"><Flecha /></button></div>
  </dialog>
</Base>

<style>
.ficha{padding-top:clamp(40px,5vw,72px);padding-bottom:clamp(72px,8vw,120px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:48px clamp(40px,6vw,120px);align-items:start}
.ficha-lat{display:grid;gap:28px;position:sticky;top:104px}
dl>div{display:grid;grid-template-columns:130px 1fr;gap:16px;padding:16px 0;border-bottom:1px solid var(--linea)}
dt{font-size:15px;color:var(--suave)}dd{font-size:16px}
.galeria{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:clamp(12px,1.6vw,24px)}
.g-item{padding:0;border:0;background:none;cursor:zoom-in;aspect-ratio:4/3;width:100%}
.g-item.ancho{grid-column:1/-1;aspect-ratio:16/9}
.g-item :global(.foto){height:100%}
.lb{border:0;padding:0;width:100vw;height:100dvh;max-width:none;max-height:none;background:#141614;color:#F7F5F1}
.lb[open]{display:grid;grid-template-rows:auto 1fr auto}
.lb-top,.lb-pie{display:flex;justify-content:space-between;align-items:center;padding:12px clamp(12px,3vw,32px)}
.lb-n{color:#C9C5BD}
.lb button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-width:52px;height:48px;padding:0 16px;border:1px solid #5A5D58;background:transparent;color:#F7F5F1;font:400 16px 'IBM Plex Sans',sans-serif;cursor:pointer}
.lb-img{width:100%;height:100%;object-fit:contain;min-height:0}
</style>
<script>
  const lb = document.querySelector<HTMLDialogElement>('.lb')!;
  const srcs: string[] = JSON.parse(lb.dataset.src!);
  const img = lb.querySelector<HTMLImageElement>('.lb-img')!;
  let i = 0;
  const ver = (n: number) => {
    i = (n + srcs.length) % srcs.length;
    img.src = srcs[i];
    img.alt = `${lb.dataset.alt}: imagen ${i + 1} de ${srcs.length}`;
    lb.querySelector('.lb-n')!.textContent = `${i + 1} / ${srcs.length}`;
  };
  document.querySelectorAll<HTMLButtonElement>('.g-item').forEach((b) => b.addEventListener('click', () => { ver(+b.dataset.i!); lb.showModal(); }));
  lb.querySelector('.lb-x')!.addEventListener('click', () => lb.close());
  lb.querySelector('.lb-ant')!.addEventListener('click', () => ver(i - 1));
  lb.querySelector('.lb-sig')!.addEventListener('click', () => ver(i + 1));
  lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') ver(i + 1); if (e.key === 'ArrowLeft') ver(i - 1); });
</script>
