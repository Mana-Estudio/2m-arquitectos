---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { fotos } from '../data';
---
<Base title="Página no encontrada · 2M Arquitectos" description="La página que buscas no existe. Vuelve al inicio o mira nuestros proyectos.">
  <section class="wrap sec nf" style="padding-top:clamp(36px,4.5vw,72px)">
    <div style="display:grid;gap:24px;align-content:center">
      <h1 class="h1">Esta página no existe</h1>
      <p class="lead">Puede que el enlace sea antiguo o que la hayamos movido. Nuestros proyectos y el contacto siguen donde siempre.</p>
      <div class="fila"><a href="/proyectos/" class="btn btn-v">Ver proyectos</a><a href="/" class="btn btn-l">Ir al inicio</a></div>
    </div>
    <Foto src={fotos('valle-de-tobalina')[0]} alt="Vivienda en Valle de Tobalina, Las Lomas, Boadilla del Monte" sizes="(min-width: 960px) 50vw, 100vw" style="aspect-ratio:4/3" />
  </section>
</Base>
<style>.nf{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:48px clamp(32px,5vw,96px);align-items:center}</style>
