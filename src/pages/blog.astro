---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Flecha from '../components/Flecha.astro';
import Cta from '../components/Cta.astro';
import { notas, fotos } from '../data';
const imgs = fotos('blog');
const [destacada, ...resto] = notas;
---
<Base title="Blog de arquitectura · 2M Arquitectos" activo="blog"
  description="Ideas, materiales y tendencias para proyectar una casa, escritas por el equipo de 2M Arquitectos.">
  <div class="wrap" style="padding-top:clamp(36px,4.5vw,72px);padding-bottom:var(--sec)">
    <div class="grid-intro" style="padding-bottom:clamp(24px,3vw,36px);border-bottom:1px solid var(--texto)"><h1 class="h1">Blog</h1><p class="lead">Ideas, materiales y tendencias para proyectar una casa. Escrito por el equipo del estudio.</p></div>
    <h2 class="sr">Artículos</h2>
    <a href={destacada.url} class="dest">
      <Foto src={imgs[0]} alt={`Imagen del artículo ${destacada.t}`} sizes="(min-width: 960px) 50vw, 100vw" style="aspect-ratio:3/2" />
      <div style="display:grid;gap:16px;align-content:end">
        <span class="muted" style="font-size:14px">{destacada.fecha}</span>
        <h3 style="font:400 clamp(28px,3vw,44px)/1.1 var(--titulo);letter-spacing:-.025em;text-wrap:balance">{destacada.t}</h3>
        <span style="text-decoration:underline;text-underline-offset:5px">Leer artículo <Flecha /></span>
      </div>
    </a>
    <div class="grilla" style="border-top:1px solid var(--linea);padding-top:clamp(32px,3.5vw,48px)">
      {resto.map((n, i) => (
        <a href={n.url} class="tarjeta">
          <Foto src={imgs[i + 1]} alt={`Imagen del artículo ${n.t}`} />
          <div><span class="muted" style="font-size:14px">{n.fecha}</span><h3 style="margin-top:8px">{n.t}</h3></div>
        </a>
      ))}
    </div>
  </div>
  <Cta titulo="¿Lo hablamos para tu casa?" foto="torrelodones" />
</Base>

<style>
.dest{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:24px clamp(32px,5vw,80px);align-items:end;text-decoration:none;color:var(--texto);margin:clamp(28px,3.5vw,48px) 0 clamp(36px,4.5vw,64px)}
</style>
