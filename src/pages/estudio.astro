---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Cta from '../components/Cta.astro';
import Flecha from '../components/Flecha.astro';
import Cifras from '../components/Cifras.astro';
import Testimonios from '../components/Testimonios.astro';
import { equipo, fotos, colaboradores, serviciosDet } from '../data';
const tira = ['majadahonda', 'sanxenxo', 'las-rozas', 'valle-de-cares'];
// MUESTRA: valores redactados a partir del tono de su web actual
const valores = [
  { t: 'El usuario, primero', d: 'Proyectamos para quien va a vivir la casa. Sus rutinas, su luz y su forma de habitar mandan sobre el dibujo.' },
  { t: 'Líneas puras', d: 'Arquitectura sencilla y atemporal, donde cada material y cada hueco tienen una razón de ser.' },
  { t: 'Del plano a la obra', d: 'El mismo equipo que diseña dirige la obra. Lo que se dibuja es lo que se construye.' },
];
---
<Base title="Estudio de arquitectura en Boadilla del Monte · 2M Arquitectos" activo="estudio"
  description="2M Arquitectos: equipo de arquitectos, arquitectos técnicos e ingenieros en Boadilla del Monte, Madrid. Proyecto, dirección de obra y licencias.">
  <section class="wrap e-intro" aria-labelledby="h1">
    <span class="ojo">El estudio</span>
    <h1 id="h1" class="e-h1">Cambiar la forma de ver el mundo <em>a través de la arquitectura</em></h1>
    <div class="e-sub">
      <p class="lead">Somos un estudio joven en Boadilla del Monte. Arquitectos, arquitectos técnicos e ingenieros trabajando codo con codo con cada cliente, de la primera idea a la entrega de llaves.</p>
      <a href="/presupuesto/" class="btn btn-v btn-f magnet">Empezar mi proyecto <Flecha /></a>
    </div>
  </section>

  <div class="tira caja" aria-hidden="true">
    {tira.map((s, i) => <Foto src={fotos(s)[i % 2 ? 1 : 0] ?? fotos(s)[0]} alt="" sizes="(min-width: 960px) 320px, 50vw" style={`--y:${[0, 32, 12, 44][i]}px`} />)}
  </div>

  <section class="wrap sec" aria-label="Cifras del estudio"><Cifras /></section>

  <section class="caja oscuro valores-sec" aria-labelledby="h-val">
    <div style="display:grid;gap:16px;margin-bottom:clamp(28px,3.5vw,48px)"><span class="ojo ojo-c">Lo que nos mueve</span><h2 id="h-val" class="h2">Tres ideas que guían cada proyecto</h2></div>
    <ol class="valores">
      {valores.map((v, i) => <li data-revela style={`--d:${i * .12}s`}><span class="v-n">0{i + 1}</span><h3 class="h3">{v.t}</h3><p>{v.d}</p></li>)}
    </ol>
  </section>

  <section class="wrap sec" aria-labelledby="h-eq">
    <div class="cab-sec"><div style="display:grid;gap:16px"><span class="ojo">Equipo</span><h2 id="h-eq" class="h2">Las personas detrás de cada casa</h2></div><p class="muted">Un solo interlocutor para tu proyecto.</p></div>
    <ul class="equipo">
      {equipo.map(([n, c], i) => (
        <li data-revela style={`--d:${(i % 4) * .08}s`} class:list={{ socio: c.includes('Socio') }}>
          <span class="mono-g" aria-hidden="true">{n.split(' ').map((w) => w[0]).join('')}</span>
          <div><h3 class="h3">{n}</h3><p class="muted">{c}</p></div>
        </li>
      ))}
      <li class="unete"><span class="ojo">¿Arquitecto/a?</span><p>Siempre buscamos talento.</p><a href="mailto:info@2m-arquitectos.com?subject=Candidatura" class="link">Envíanos tu CV <Flecha /></a></li>
    </ul>
  </section>

  <section class="caja serv-in" aria-labelledby="h-serv">
      <div style="display:grid;gap:16px;align-content:start"><span class="ojo">Todo lo que ofrecemos</span><h2 id="h-serv" class="h2">Servicios</h2><a href="/servicios/" class="link">Ver servicios en detalle <Flecha /></a></div>
      <ol class="serv-l">{serviciosDet.map((s, i) => <li><a href={`/servicios/#${s.id}`}><span class="mono">0{i + 1}</span>{s.t}<Flecha /></a></li>)}</ol>
  </section>

  <section class="wrap sec" aria-labelledby="h-test">
    <div style="display:grid;gap:16px;margin-bottom:28px"><span class="ojo">Clientes</span><h2 id="h-test" class="h2">Lo que dicen de nosotros</h2></div>
    <Testimonios />
  </section>

  <section class="caja" aria-labelledby="h-col" style="padding-bottom:var(--sec)">
    <h2 id="h-col" class="ojo" style="display:flex;margin-bottom:16px">Empresas colaboradoras</h2>
    <div class="marq"><div class="marq-in">{[0, 1, 2, 3].map(() => <span>{colaboradores.map((c) => <span>{c}</span>)}</span>)}</div></div>
  </section>

  <Cta titulo="Hablemos de tu casa" foto="sanxenxo" />
</Base>

<style>
.e-intro{padding-top:clamp(36px,4.5vw,72px);padding-bottom:clamp(28px,3.5vw,48px);display:grid;gap:24px}
.e-h1{font:300 clamp(44px,7vw,112px)/.96 var(--titulo);letter-spacing:-.045em;max-width:16ch}
.e-h1 em{font-style:normal;color:var(--verde)}
.e-sub{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:24px;padding-top:24px;border-top:1px solid var(--linea)}
.tira{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(12px,1.6vw,24px);padding-bottom:64px}
@media (max-width:759px){.tira{grid-template-columns:repeat(2,minmax(0,1fr))}}
.tira :global(.foto){aspect-ratio:3/4;translate:0 var(--y)}
@supports (animation-timeline:view()){.tira :global(.foto){animation:flota linear both;animation-timeline:view();animation-range:entry 0% exit 100%}@keyframes flota{from{translate:0 calc(var(--y) + 20px)}to{translate:0 calc(var(--y) - 20px)}}}
.valores-sec{padding:clamp(36px,5vw,80px) var(--in)}
.valores{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:40px 32px}
.valores li{display:grid;gap:16px;padding-top:24px;border-top:1px solid #3B3E3A}
.v-n{font:300 72px/1 var(--titulo);color:#7FA88C;letter-spacing:-.04em}
.valores p{color:#B9B5AD;font-size:16px;line-height:1.65}
.equipo{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,250px),1fr));gap:clamp(12px,1.6vw,20px)}
.equipo li{display:grid;gap:16px;align-content:start}
.mono-g{aspect-ratio:1;background:var(--piedra);display:grid;place-items:center;font:300 clamp(56px,6vw,88px)/1 var(--titulo);letter-spacing:-.05em;color:var(--suave);transition:background-color .5s,color .5s;position:relative;overflow:hidden}
.mono-g::after{content:'';position:absolute;inset:0;background:var(--verde);transform:translateY(101%);transition:transform .6s cubic-bezier(.16,1,.3,1);z-index:0}
.equipo li:hover .mono-g{color:#fff}
.equipo li:hover .mono-g::after{transform:none}
.mono-g{isolation:isolate}.mono-g::after{z-index:-1}
.socio .mono-g{background:var(--texto);color:#fff}
.unete{background:var(--fondo);border:1px dashed var(--linea);padding:24px;align-content:end!important;aspect-ratio:1}
.unete p{font:300 26px/1.2 var(--titulo)}
.serv-in{background:var(--piedra);padding:clamp(36px,5vw,80px) var(--in);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:28px clamp(32px,5vw,88px);align-items:start}
.serv-l{list-style:none;margin:0;padding:0;border-top:1px solid var(--texto)}
.serv-l a{display:grid;grid-template-columns:44px 1fr auto;gap:12px;align-items:center;padding:18px 0;border-bottom:1px solid #C8CAC5;font:400 clamp(20px,1.7vw,26px)/1.3 var(--titulo);text-decoration:none;color:var(--texto);transition:padding .4s cubic-bezier(.16,1,.3,1),color .3s}
.serv-l a:hover{padding-left:12px;color:var(--verde)}
@media (prefers-reduced-motion:reduce){.tira :global(.foto){animation:none}}
</style>
