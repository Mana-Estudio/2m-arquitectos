---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Cta from '../components/Cta.astro';
import { equipo, fotos } from '../data';
const servicios = ['Desarrollo integral de proyectos de arquitectura', 'Proyectos básicos y de ejecución', 'Diseño personalizado', 'Dirección de obra de arquitecto y aparejador', 'Licencias de actividad'];
---
<Base title="Estudio de arquitectura en Boadilla del Monte · 2M Arquitectos" activo="estudio"
  description="2M Arquitectos: equipo de arquitectos, arquitectos técnicos e ingenieros en Boadilla del Monte, Madrid. Proyecto, dirección de obra y licencias.">
  <section class="wrap intro">
    <h1 class="h1" style="max-width:11ch">Estudio de arquitectura en Boadilla del Monte</h1>
    <p style="font:400 clamp(20px,1.8vw,26px)/1.45 var(--titulo);color:#2A2C29;max-width:36ch">Proyectamos para quien va a vivir en la casa. Líneas puras, luz y espacios sencillos. Trabajamos codo con codo con cada cliente, con un equipo propio de arquitectos, arquitectos técnicos e ingenieros.</p>
  </section>
  <Foto src={fotos('majadahonda')[0]} alt="Viviendas unifamiliares aisladas en Majadahonda, proyecto de 2M Arquitectos" sizes="100vw" style="height:clamp(320px,44vw,640px)" />

  <section class="wrap sec" aria-labelledby="h-eq">
    <div class="cab-sec"><h2 id="h-eq" class="h2">Equipo</h2><p class="muted">Siete personas, un solo interlocutor para tu proyecto.</p></div>
    <ul class="equipo">{equipo.map(([n, c]) => <li><h3 class="h3">{n}</h3><p class="muted">{c}</p></li>)}</ul>
  </section>

  <section style="background:var(--piedra)" aria-labelledby="h-serv">
    <div class="wrap sec serv-in">
      <h2 id="h-serv" class="h2">Servicios</h2>
      <ol class="serv-l">{servicios.map((t, i) => <li><span class="mono">0{i + 1}</span><span>{t}</span></li>)}</ol>
    </div>
  </section>

  <Cta titulo="Hablemos de tu casa" />
</Base>

<style>
.intro{padding-top:clamp(48px,6vw,96px);padding-bottom:clamp(48px,6vw,88px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:28px clamp(40px,6vw,120px);align-items:end}
.equipo{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:0 clamp(16px,2vw,28px);border-top:1px solid var(--texto)}
.equipo li{padding:24px 0;border-bottom:1px solid var(--linea);display:grid;gap:6px}
.serv-in{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:32px clamp(40px,6vw,120px);align-items:start}
.serv-l{list-style:none;margin:0;padding:0;border-top:1px solid var(--texto)}
.serv-l li{display:grid;grid-template-columns:48px 1fr;gap:16px;padding:22px 0;border-bottom:1px solid #C9C3B8;align-items:baseline;font:400 clamp(20px,1.7vw,24px)/1.3 var(--titulo)}
</style>
