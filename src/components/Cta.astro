---
import Foto from './Foto.astro';
import Flecha from './Flecha.astro';
import { TEL, TEL_HREF, fotos, waTexto } from '../data';
interface Props { titulo: string; texto?: string; foto?: string }
const { titulo, texto = 'Cuéntanos qué quieres construir y dónde. Respondemos en menos de 24 horas laborables.', foto = 'valle-de-cares' } = Astro.props;
---
<section class="cta caja" aria-labelledby="h-cta">
  <Foto src={fotos(foto)[0]} alt="" sizes="(min-width: 1360px) 1280px, 100vw" class="cta-foto" />
  <div class="in cta-in">
    <div><span class="ojo ojo-c">Primera reunión sin coste</span><h2 id="h-cta" style="margin-top:20px">{titulo}</h2>{texto && <p>{texto}</p>}</div>
    <div style="display:grid;gap:14px;justify-items:start">
      <div class="fila"><a href="/presupuesto/" class="btn btn-v btn-f magnet">Calcular presupuesto <Flecha /></a><a href={waTexto('Hola, 2M Arquitectos. Quiero contaros mi proyecto.')} class="btn btn-c magnet" rel="noopener">Escribir por WhatsApp</a></div>
      <a href={TEL_HREF} class="link tel">o llama al {TEL}</a>
    </div>
  </div>
</section>
<style>
.cta{position:relative;overflow:hidden;isolation:isolate;margin-bottom:clamp(20px,3vw,40px)}
.cta-in{padding:clamp(40px,5.5vw,88px) var(--in)}
.cta :global(.cta-foto){position:absolute;inset:0;z-index:-1;opacity:.3}
.cta::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,var(--osc) 30%,transparent)}
</style>
